<?xml version="1.0" encoding="UTF-8"?>
<!--
  EDV Personalaufnahme – EDV Personaleintrittsschein Formular (Outlook add-in)
  Hosted at: https://peti0127.github.io/EDV_Personaleintrittsschein/
  To move to another host, replace "https://peti0127.github.io/EDV_Personaleintrittsschein" everywhere in this file.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>7a9fc23c-dedb-4e83-8d36-3791bc0cc7c5</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Attensam</ProviderName>
  <DefaultLocale>de-AT</DefaultLocale>
  <DisplayName DefaultValue="EDV Personalaufnahme"/>
  <Description DefaultValue="EDV Personaleintrittsschein Formular ausfüllen und an EDV schicken"/>
  <IconUrl DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/Images/Icons/Icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/Images/Icons/Icon-128.png"/>
  <SupportUrl DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/hilfe.html"/>
  <AppDomains>
    <AppDomain>https://peti0127.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <!-- Button in the ribbon of a new e-mail / reply -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="personaleintrittGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="personaleintrittButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/Images/Icons/Icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/Images/Icons/Icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/Images/Icons/Icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://peti0127.github.io/EDV_Personaleintrittsschein/Resources/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Attensam"/>
          <bt:String id="Button.Label" DefaultValue="EDV Personalaufnahme"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="EDV Personaleintrittsschein Formular ausfüllen und an EDV schicken"/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
